# ─── IDE / Editor / AI Assistant ────────────────────────────────────────────
.antigravityignore
implementation_plan.md
task.md
walkthrough.md

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
backend/__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
backend/venv/
*.egg-info/
.eggs/
.mypy_cache/
.pytest_cache/
backend/.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
*.cover

# ─── Environment (NEVER commit secrets) ───────────────────────────────────────
.env
.env.*
!.env.example

# ─── Node / npm ───────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.local

# ─── Vite build outputs ────────────────────────────────────────────────────────
dist/
dist-ssr/
frontend/.vite/

# ─── Editor / OS ──────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Database / temp ──────────────────────────────────────────────────────────
