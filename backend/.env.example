# ─── Required ─────────────────────────────────────────────────────────────────
# Gemini API key — used for task classification and plan generation
GOOGLE_API_KEY=your_google_gemini_api_key_here

# ─── Model Tier Labels (display only — shown in the UI) ───────────────────────
# These are the names shown in the UI for each cost tier.
# Swap them for any model names relevant to your stack.
FAST_MODEL=gpt-5-mini
BALANCED_MODEL=gpt-5
POWERFUL_MODEL=gpt-5-pro

# ─── Pricing — USD per 1,000,000 tokens ───────────────────────────────────────
# Used to calculate and compare adaptive vs static routing costs.
# Default values reflect OpenAI pricing as of 2025.
FAST_INPUT_COST=0.25
FAST_OUTPUT_COST=2.00

BALANCED_INPUT_COST=1.25
BALANCED_OUTPUT_COST=10.00

POWERFUL_INPUT_COST=15.00
POWERFUL_OUTPUT_COST=120.00

# ─── Optional ─────────────────────────────────────────────────────────────────
MODEL_RETRY_COUNT=1
